# Copy to .env and adjust. Never commit .env.
# Used by docker-compose.yml and (optionally) by the backend via spring.config.import.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=eventhub
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub
POSTGRES_PORT=5433

# --- Backend (Spring Boot) ---
DB_URL=jdbc:postgresql://localhost:5433/eventhub
DB_USERNAME=eventhub
DB_PASSWORD=eventhub
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth ---
# REQUIRED. Base64 HMAC key (>= 32 bytes). Generate one:
#   Git Bash:   openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) }))
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d
# Local dev runs on plain http, so the refresh cookie cannot be Secure. Use true in any deployed environment.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Strict

# --- Email (booking confirmations) ---
# Local dev uses Mailpit from docker-compose: open http://localhost:8025 to read sent emails.
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=EventHub <no-reply@eventhub.local>
FRONTEND_URL=http://localhost:5173

# --- Dev account seeding (local only; never enable in production) ---
APP_SEED_ENABLED=true
DEV_ADMIN_EMAIL=admin@eventhub.local
DEV_ADMIN_PASSWORD=
DEV_ORGANIZER_EMAIL=organizer@eventhub.local
DEV_ORGANIZER_PASSWORD=

# Demo events for local browsing (only with APP_SEED_ENABLED=true)
APP_SEED_DEMO_EVENTS=true
